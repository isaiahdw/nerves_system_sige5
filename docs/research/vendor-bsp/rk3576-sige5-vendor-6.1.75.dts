	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		ramoops@40110000 {
			boot-log-count = <0x01>;
			record-size = <0x14000>;
			pmsg-size = <0x30000>;
			compatible = "ramoops";
