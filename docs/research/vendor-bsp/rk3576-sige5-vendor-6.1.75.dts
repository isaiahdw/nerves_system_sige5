			reg = <0x00 0x00 0x00 0x00>;
			phandle = <0x24>;
		};
	};

	pcie@2a200000 {
		power-domains = <0x03 0x08>;
		vpcie3v3-supply = <0xf0>;
		#address-cells = <0x03>;
		dma-coherent;
		phy-names = "pcie-phy";
