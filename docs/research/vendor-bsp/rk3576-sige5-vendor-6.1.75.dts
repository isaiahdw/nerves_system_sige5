	syscon@2602e000 {
		#address-cells = <0x01>;
		clocks = <0x02 0x1f4>;
		#size-cells = <0x01>;
		compatible = "rockchip,rk3576-usb2phy-grf\0syscon\0simple-mfd";
		reg = <0x00 0x2602e000 0x00 0x4000>;
		phandle = <0x18b>;

		usb2-phy@2000 {
			clock-output-names = "usb480m_phy1";
			clock-names = "phyclk\0aclk\0aclk_slv";
			resets = <0x02 0x80018 0x02 0x8000a>;
			clocks = <0x02 0x21b 0x02 0x110 0x02 0x111>;
			#clock-cells = <0x00>;
			rockchip,usbctrl-grf = <0x5c>;
			compatible = "rockchip,rk3576-usb2phy";
			status = "okay";
			reg = <0x2000 0x10>;
			phandle = <0x210>;
			reset-names = "phy\0apb";

			otg-port {
				phy-supply = <0x5d>;
				interrupts = <0x00 0x162 0x04 0x00 0x163 0x04 0x00 0x164 0x04>;
				#phy-cells = <0x00>;
				status = "okay";
				interrupt-names = "otg-bvalid\0otg-id\0linestate";
				phandle = <0x59>;
			};
		};

		usb2-phy@0 {
			clock-output-names = "usb480m_phy0";
			clock-names = "phyclk\0aclk\0aclk_slv";
			resets = <0x02 0x80017 0x02 0x80009>;
			clocks = <0x02 0x21b 0x02 0x14e 0x02 0x14f>;
			#clock-cells = <0x00>;
			rockchip,usbctrl-grf = <0x5b>;
			compatible = "rockchip,rk3576-usb2phy";
			status = "okay";
			reg = <0x00 0x10>;
			phandle = <0x20f>;
			reset-names = "phy\0apb";

			otg-port {
				interrupts = <0x00 0x15e 0x04 0x00 0x15f 0x04 0x00 0x160 0x04>;
				#phy-cells = <0x00>;
				rockchip,typec-vbus-det;
				status = "okay";
				interrupt-names = "otg-bvalid\0otg-id\0linestate";
				phandle = <0x56>;
			};
		};
	};

	rkcif-mipi-lvds2-sditf {
		compatible = "rockchip,rkcif-sditf";
		status = "disabled";
		rockchip,cif = <0x3c>;
		phandle = <0x1e3>;
	};

	qos@27f08080 {
		compatible = "syscon";
		reg = <0x00 0x27f08080 0x00 0x20>;
		phandle = <0x6c>;
	};

	rkcif-mipi-lvds1-sditf-vir1 {
		compatible = "rockchip,rkcif-sditf";
		status = "disabled";
		rockchip,cif = <0x3b>;
		phandle = <0x1e0>;
	};

	edp@27dc0000 {
		power-domains = <0x03 0x10>;
		phy-names = "dp";
		clock-names = "dp\0pclk\0spdif\0hclk";
		resets = <0x02 0x40e 0x02 0x40d>;
		interrupts = <0x00 0x16d 0x04>;
		clocks = <0x02 0x1a1 0x02 0x1a0 0x02 0x1a2 0x02 0x194>;
		#sound-dai-cells = <0x01>;
		compatible = "rockchip,rk3576-edp";
		status = "disabled";
		rockchip,grf = <0xa6>;
		phys = <0xde>;
		reg = <0x00 0x27dc0000 0x00 0x1000>;
		phandle = <0x233>;
		reset-names = "dp\0apb";

		ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			port@0 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x00>;

				endpoint@3 {
					remote-endpoint = <0xe1>;
					status = "disabled";
					reg = <0x03>;
					phandle = <0xa9>;
				};

				endpoint@1 {
					remote-endpoint = <0x27>;
					status = "disabled";
					reg = <0x01>;
					phandle = <0xc2>;
				};

				endpoint@2 {
					remote-endpoint = <0xe0>;
					status = "disabled";
					reg = <0x02>;
					phandle = <0xc9>;
				};

				endpoint@0 {
					remote-endpoint = <0xdf>;
					status = "disabled";
					reg = <0x00>;
					phandle = <0xbb>;
				};
			};
		};
	};

	vcc1v8-ufs-vccq2-s0 {
		regulator-max-microvolt = <0x1b7740>;
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <0x1b7740>;
		regulator-name = "vcc1v8_ufs_vccq2_s0";
		compatible = "regulator-fixed";
		phandle = <0x54f>;
		vin-supply = <0x172>;
	};

	phy@2b010000 {
		svid = <0xff01>;
		orientation-switch;
		sbu2-dc-gpios = <0xd3 0x07 0x00>;
		clock-names = "refclk\0immortal\0pclk";
		resets = <0x02 0x8000f 0x02 0x80010 0x02 0x80011 0x02 0x80012 0x02 0x8000c>;
		clocks = <0x02 0x21b 0x02 0x1dd 0x02 0x1db>;
		compatible = "rockchip,rk3576-usbdp-phy";
		status = "okay";
		reg = <0x00 0x2b010000 0x00 0x10000>;
		phandle = <0x2d4>;
		rockchip,usb-grf = <0x5b>;
		reset-names = "init\0cmn\0lane\0pcs_apb\0pma_apb";
		rockchip,u2phy-grf = <0x18b>;
		sbu1-dc-gpios = <0xd3 0x06 0x00>;
		rockchip,usbdpphy-grf = <0x18c>;
		rockchip,vo-grf = <0xeb>;

		dp-port {
			#phy-cells = <0x00>;
			status = "okay";
			phandle = <0xe2>;
		};

		port {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			endpoint@1 {
				remote-endpoint = <0x18e>;
				reg = <0x01>;
				phandle = <0x14f>;
			};

			endpoint@0 {
				remote-endpoint = <0x18d>;
				reg = <0x00>;
				phandle = <0x14e>;
			};
		};

		u3-port {
			#phy-cells = <0x00>;
			status = "okay";
			phandle = <0x57>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@1 {
			capacity-dmips-mhz = <0x1e5>;
			clocks = <0x0c 0x0a>;
			cpu-idle-states = <0x0e>;
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x01>;
			enable-method = "psci";
			phandle = <0x05>;
			operating-points-v2 = <0x0d>;
		};

		cpu@103 {
			capacity-dmips-mhz = <0x400>;
			clocks = <0x0c 0x0b>;
			cpu-idle-states = <0x0e>;
			device_type = "cpu";
			compatible = "arm,cortex-a72";
			reg = <0x103>;
			enable-method = "psci";
			phandle = <0x0b>;
			operating-points-v2 = <0x10>;
		};

		cpu@101 {
			capacity-dmips-mhz = <0x400>;
			clocks = <0x0c 0x0b>;
			cpu-idle-states = <0x0e>;
			device_type = "cpu";
			compatible = "arm,cortex-a72";
			reg = <0x101>;
			enable-method = "psci";
			phandle = <0x09>;
			operating-points-v2 = <0x10>;
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep {
				entry-latency-us = <0x78>;
				local-timer-stop;
				exit-latency-us = <0xfa>;
				arm,psci-suspend-param = <0x10000>;
				compatible = "arm,idle-state";
				phandle = <0x0e>;
				min-residency-us = <0x384>;
			};
		};

		cpu-map {

			cluster0 {

				core3 {
					cpu = <0x07>;
				};

				core1 {
					cpu = <0x05>;
				};

				core2 {
					cpu = <0x06>;
				};

				core0 {
					cpu = <0x04>;
				};
			};

			cluster1 {

				core3 {
					cpu = <0x0b>;
				};

				core1 {
					cpu = <0x09>;
				};

				core2 {
					cpu = <0x0a>;
				};

				core0 {
					cpu = <0x08>;
				};
			};
		};

		cpu@2 {
			capacity-dmips-mhz = <0x1e5>;
			clocks = <0x0c 0x0a>;
			cpu-idle-states = <0x0e>;
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x02>;
			enable-method = "psci";
			phandle = <0x06>;
			operating-points-v2 = <0x0d>;
		};

		cpu@0 {
			capacity-dmips-mhz = <0x1e5>;
			cpu-supply = <0x0f>;
			clocks = <0x0c 0x0a>;
			cpu-idle-states = <0x0e>;
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			dynamic-power-coefficient = <0x78>;
			reg = <0x00>;
			enable-method = "psci";
			phandle = <0x04>;
			operating-points-v2 = <0x0d>;
			#cooling-cells = <0x02>;
		};

		cpu@102 {
			capacity-dmips-mhz = <0x400>;
			clocks = <0x0c 0x0b>;
			cpu-idle-states = <0x0e>;
			device_type = "cpu";
			compatible = "arm,cortex-a72";
			reg = <0x102>;
			enable-method = "psci";
			phandle = <0x0a>;
			operating-points-v2 = <0x10>;
		};

		cpu@100 {
			capacity-dmips-mhz = <0x400>;
			cpu-supply = <0x11>;
			clocks = <0x0c 0x0b>;
			cpu-idle-states = <0x0e>;
			device_type = "cpu";
			compatible = "arm,cortex-a72";
			dynamic-power-coefficient = <0x140>;
			reg = <0x100>;
			enable-method = "psci";
			phandle = <0x08>;
			operating-points-v2 = <0x10>;
			#cooling-cells = <0x02>;
		};

		cpu@3 {
			capacity-dmips-mhz = <0x1e5>;
			clocks = <0x0c 0x0a>;
			cpu-idle-states = <0x0e>;
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x03>;
			enable-method = "psci";
			phandle = <0x07>;
			operating-points-v2 = <0x0d>;
		};
	};

	sata@2a240000 {
		power-domains = <0x03 0x09>;
		dma-coherent;
		phy-names = "sata-phy";
