Add the vendor RKNPU node for the out-of-tree rknpu module
(package/rknpu-driver) and librknnrt.

Register map, interrupts, clocks, resets and power domains are taken
from the vendor rk3576.dtsi at the same commit the driver comes from.
Three deliberate differences from the vendor node:

1. clk_npu comes from the CRU (CLK_RKNN_DSU0), not from SCMI. The
   vendor node clocks the NPU DSU through BL31's SCMI PVTPLL, but the
   SCMI rate call touches NPU_GRF/PVTPLL registers inside the NPU
   power domain. assigned-clocks are applied at probe, before the
   driver powers those domains on, and with the domains off (mainline
   disables unused domains early in boot) the call wedges the CPU in
   EL3. The CRU path only touches always-on CRU registers and drives
   the DSU from GPLL dividers, which is what the rocket bring-up on
   this SoC converged on as well.

2. No iommus property and no OPP table: the vendor IOMMU driver
   (rockchip,iommu-v2) does not exist in mainline, so the driver runs
   in CMA/contiguous buffer mode (see CONFIG_CMA_SIZE_MBYTES in
   linux/nerves.config), and devfreq is compiled out of the module, so
   the clock is fixed by assigned-clock-rates.

3. The NPU rail is pinned to 800 mV, which covers the fixed 600 MHz
   (725 mV on the vendor OPP table) with margin.

Signed-off-by: Isaiah Peng <isaiahdw@gmail.com>

--- a/arch/arm64/boot/dts/rockchip/rk3576-armsom-sige5.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3576-armsom-sige5.dts
@@ -1050,3 +1050,40 @@
 &wdt {
 	status = "okay";
 };
+
+&{/soc} {
+	rknpu: npu@27700000 {
+		compatible = "rockchip,rk3576-rknpu";
+		reg = <0x0 0x27700000 0x0 0x8000>,
+		      <0x0 0x27708000 0x0 0x8000>;
+		interrupts = <GIC_SPI 247 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "npu0_irq", "npu1_irq";
+		clocks = <&cru CLK_RKNN_DSU0>, <&cru ACLK_RKNN0>,
+			 <&cru ACLK_RKNN1>, <&cru HCLK_RKNN_ROOT>,
+			 <&cru ACLK_RKNN_CBUF>, <&cru HCLK_RKNN_CBUF>;
+		clock-names = "clk_npu", "aclk0", "aclk1", "hclk_root",
+			      "aclk_cbuf", "hclk_cbuf";
+		assigned-clocks = <&cru CLK_RKNN_DSU0>;
+		assigned-clock-rates = <600000000>;
+		resets = <&cru SRST_A_RKNN0>, <&cru SRST_A_RKNN1>,
+			 <&cru SRST_A_RKNN_CBUF>, <&cru SRST_H_RKNN_CBUF>;
+		reset-names = "srst_a0", "srst_a1",
+			      "srst_a_cbuf", "srst_h_cbuf";
+		power-domains = <&power RK3576_PD_NPU0>,
+				<&power RK3576_PD_NPU1>;
+		power-domain-names = "npu0", "npu1";
+		status = "okay";
+	};
+};
+
+/*
+ * The NPU rail: nothing manages it at runtime (devfreq is compiled out
+ * of the rknpu module), so keep it on at a voltage that covers the
+ * fixed NPU clock.
+ */
+&vdd_npu_s0 {
+	regulator-always-on;
+	regulator-min-microvolt = <800000>;
+	regulator-max-microvolt = <800000>;
+};
