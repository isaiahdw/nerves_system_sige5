Wire the NPU MMU to the mainline rockchip-iommu driver.

One node for both cores' bank pairs (registers from the vendor tree:
core_base + 0x2000/0x2100), rk3568-iommu compatible, both NPU core
power domains listed - rockchip-iommu attaches the full list with
runtime-PM device links (see the companion driver patch), so any bank
access happens with its domain powered.

With iommus present the rknpu driver leaves CMA/contiguous mode:
buffers become pageable and the 256 MB CMA cap no longer applies to
the NPU.

Signed-off-by: Isaiah DeRose-Wilson <isaiahdw@gmail.com>

--- a/arch/arm64/boot/dts/rockchip/rk3576-armsom-sige5.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3576-armsom-sige5.dts
@@ -1124,3 +1124,30 @@
 	status = "okay";
 	vref-supply = <&vcca_1v8_s0>;
 };
+
+/*
+ * NPU MMU, driven by mainline rockchip-iommu. One instance covering both
+ * cores' bank pairs (core_base + 0x2000/0x2100), as in the vendor tree -
+ * the driver supports one IOMMU per master. The banks sit in the two NPU
+ * core power domains; both are listed, and the driver attaches the full
+ * list with runtime-PM links so a bank is never touched unpowered.
+ */
+&{/soc} {
+	rknpu_mmu: iommu@27702000 {
+		compatible = "rockchip,rk3576-iommu", "rockchip,rk3568-iommu";
+		reg = <0x0 0x27702000 0x0 0x100>,
+		      <0x0 0x27702100 0x0 0x100>,
+		      <0x0 0x2770a000 0x0 0x100>,
+		      <0x0 0x2770a100 0x0 0x100>;
+		interrupts = <GIC_SPI 247 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_RKNN0>, <&cru HCLK_RKNN_ROOT>,
+			 <&cru ACLK_RKNN1>, <&cru ACLK_RKNN_CBUF>,
+			 <&cru HCLK_RKNN_CBUF>;
+		clock-names = "aclk", "iface", "aclk1",
+			      "aclk_cbuf", "hclk_cbuf";
+		#iommu-cells = <0>;
+		power-domains = <&power RK3576_PD_NPU0>,
+				<&power RK3576_PD_NPU1>;
+	};
+};
