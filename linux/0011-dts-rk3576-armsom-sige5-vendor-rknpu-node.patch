Add the RKNPU node and its OPP table.

Registers, interrupts, clocks, resets and power domains come from the
vendor rk3576.dtsi at the same commit as the driver.

clk_npu is the SCMI handle, as in the vendor tree. The CRU can only make
300, 400, 500, 600 and 800 from GPLL 1188, CPLL 1000, AUPLL 786 and SPLL
702; 700 and 900 exist only behind BL31's PVTPLL.

Frequencies and voltages are the vendor's, carried per variant. The
opp-supported-hw masks are the vendor's own, and the driver selects with
them after reading specification_serial_number from OTP, so an RK3576S
gets its 500 MHz ceiling and the J and M parts their higher voltages.

Within a variant each point takes the highest voltage the vendor lists
for it, since the speed grade behind those per-level voltages comes from
a runtime PVTM measurement that is not reimplemented here. For a plain
RK3576 that is 725 mV at 300 and 400, 737.5 at 500 and 600, 775 at 700,
800 at 800 and 850 at 900, except at the bottom, where the vendor's
separate 750 mV floor below 15 C is higher and is held unconditionally
rather than tracked - so 300 through 600 MHz read 750. All sit under the
918 mV NPU_DVDD maximum in table 3-2 of the datasheet.

The table stops at 900 rather than the 950 that table 3-2 allows, because
BL31 has no such rate: rk3576_npu_rates in TF-A goes 800, 900, then
1000000063. 950 could only round to 900 or to a rate above the rated
maximum.

Also give the NPU a passive thermal trip. Its zone upstream has only a
critical trip at 115 C because mainline has no NPU driver to throttle,
which left sustained inference with nothing between it and a critical
reset.

Signed-off-by: Isaiah DeRose-Wilson <isaiahdw@gmail.com>

--- a/arch/arm64/boot/dts/rockchip/rk3576-armsom-sige5.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3576-armsom-sige5.dts
@@ -1050,3 +1050,243 @@
 &wdt {
 	status = "okay";
 };
+
+/ {
+	soc {
+		rknpu: npu@27700000 {
+			compatible = "rockchip,rk3576-rknpu";
+			reg = <0x0 0x27700000 0x0 0x8000>,
+			      <0x0 0x27708000 0x0 0x8000>;
+			interrupts = <GIC_SPI 247 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "npu0_irq", "npu1_irq";
+			/*
+			 * clk_npu is the SCMI handle: BL31 owns the NPU PVTPLL and is
+			 * the only way past 786 MHz, which is all the CRU dividers can
+			 * make from GPLL/CPLL/AUPLL/SPLL.
+			 *
+			 * PCLK_NPUTOP_ROOT matters as much as the rest. BL31 programs
+			 * PVTPLL by writing registers in the NPU top, reached over
+			 * that APB clock, and it does not enable the clock itself -
+			 * it assumes the kernel holds it. Mainline declares
+			 * PCLK_NPUTOP_ROOT without CLK_IS_CRITICAL, so with nobody
+			 * claiming it the clock is gated and every SCMI rate change
+			 * writes into a dead bus and hangs the CPU. Listing it here
+			 * is what makes the SCMI path usable at all.
+			 *
+			 * No assigned-clocks: those are applied at probe with the NPU
+			 * domain still down, and PVTPLL lives inside that domain.
+			 */
+			clocks = <&scmi_clk 238>, <&cru ACLK_RKNN0>,
+				 <&cru ACLK_RKNN1>, <&cru HCLK_RKNN_ROOT>,
+				 <&cru ACLK_RKNN_CBUF>, <&cru HCLK_RKNN_CBUF>,
+				 <&cru PCLK_NPUTOP_ROOT>;
+			clock-names = "clk_npu", "aclk0", "aclk1", "hclk_root",
+				      "aclk_cbuf", "hclk_cbuf", "pclk";
+			resets = <&cru SRST_A_RKNN0>, <&cru SRST_A_RKNN1>,
+				 <&cru SRST_A_RKNN_CBUF>, <&cru SRST_H_RKNN_CBUF>;
+			reset-names = "srst_a0", "srst_a1",
+				      "srst_a_cbuf", "srst_h_cbuf";
+			power-domains = <&power RK3576_PD_NPU0>,
+					<&power RK3576_PD_NPU1>;
+			power-domain-names = "npu0", "npu1";
+			operating-points-v2 = <&npu_opp_table>;
+			rknpu-supply = <&vdd_npu_s0>;
+			iommus = <&rknpu_mmu>;
+			#cooling-cells = <2>;
+			nvmem-cells = <&specification_serial_number>;
+			nvmem-cell-names = "specification_serial_number";
+			status = "okay";
+		};
+	};
+};
+
+/*
+ * The OTP cell that says which RK3576 variant this is. Upstream describes
+ * the leakage and trim cells but not this one; the offset and width are the
+ * vendor's (rk3576.dtsi specification-serial-number@8).
+ */
+&otp {
+	specification_serial_number: specification-serial-number@8 {
+		reg = <0x08 0x1>;
+		bits = <0 5>;
+	};
+};
+
+/*
+ * The npu-thermal zone upstream has only a critical trip at 115 C, since
+ * mainline has no NPU driver and so nothing to throttle. Give it the same
+ * passive trip and cooling map the GPU zone already uses, so sustained
+ * inference scales the NPU down instead of running to a critical reset.
+ */
+&npu_thermal {
+	polling-delay-passive = <100>;
+
+	trips {
+		npu_alert: npu-alert {
+			temperature = <85000>;
+			hysteresis = <2000>;
+			type = "passive";
+		};
+	};
+
+	cooling-maps {
+		map0 {
+			trip = <&npu_alert>;
+			cooling-device = <&rknpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+		};
+	};
+};
+
+/*
+ * NPU operating points, from the vendor's rk3576.dtsi npu_opp_table.
+ *
+ * The vendor bins these two ways, and each is handled differently here.
+ *
+ * Variant. RK3576 against the S, J and M parts, which have their own
+ * frequencies and voltages; the S caps the NPU at 500 MHz. It comes from one
+ * OTP cell, so opp-supported-hw carries the vendor's own masks and the driver
+ * reads the cell and selects with them.
+ *
+ * Speed grade. The vendor picks between eleven per-OPP voltages from a PVTM
+ * measurement taken at runtime. That is not reimplemented, so each point
+ * carries the highest voltage the vendor lists for its bin - what the slowest
+ * silicon in that bin is given. Good parts run richer than they need to, by up
+ * to 50 mV at 700 MHz.
+ *
+ * The low end is higher still, at a flat 750 mV through 600 MHz. That is the
+ * vendor's rockchip,low-temp-min-volt, the floor it holds below 15 C, applied
+ * unconditionally rather than tracked against temperature.
+ *
+ * The table stops at 900 MHz. Table 3-2 of the datasheet allows 950 and the
+ * vendor table has an entry for it, but BL31 does not: rk3576_npu_rates in
+ * TF-A runs ... 800, 900, 1000000063, so 950 could only land on 900 or on a
+ * rate above the rated maximum. 700 and 900 are reachable only through BL31's
+ * PVTPLL over SCMI; the CRU dividers stop at 786 MHz.
+ */
+/ {
+	npu_opp_table: opp-table-npu {
+		compatible = "operating-points-v2-rknpu";
+
+		/*
+		 * SRAM read margin, written to NPU_GRF_MEM_CON0/1/2 as part of
+		 * each transition. The thresholds are the vendor's: the first
+		 * entry at or below the new rail voltage wins, so the points
+		 * here land on margin 3 at 750 mV and 2 from 775 mV up. The
+		 * reset value is 4, which is not the same as leaving it alone -
+		 * the setting trades voltage tolerance against access timing.
+		 */
+		rockchip,grf = <&npu_grf>;
+		rockchip,volt-mem-read-margin = <855000 1>,
+						<765000 2>,
+						<675000 3>,
+						<495000 4>;
+
+		/* RK3576, and the reserved bins 4-7 the vendor groups with it */
+		opp-300000000 {
+			opp-supported-hw = <0xf9 0xffff>;
+			opp-hz = /bits/ 64 <300000000>;
+			opp-microvolt = <750000>;
+		};
+		opp-400000000 {
+			opp-supported-hw = <0xf9 0xffff>;
+			opp-hz = /bits/ 64 <400000000>;
+			opp-microvolt = <750000>;
+		};
+		opp-500000000 {
+			opp-supported-hw = <0xf1 0xffff>;
+			opp-hz = /bits/ 64 <500000000>;
+			opp-microvolt = <750000>;
+		};
+		opp-600000000 {
+			opp-supported-hw = <0xf1 0xffff>;
+			opp-hz = /bits/ 64 <600000000>;
+			opp-microvolt = <750000>;
+		};
+		opp-700000000 {
+			opp-supported-hw = <0xf1 0xffff>;
+			opp-hz = /bits/ 64 <700000000>;
+			opp-microvolt = <775000>;
+		};
+		opp-800000000 {
+			opp-supported-hw = <0xf1 0xffff>;
+			opp-hz = /bits/ 64 <800000000>;
+			opp-microvolt = <800000>;
+		};
+		opp-900000000 {
+			opp-supported-hw = <0xf1 0xffff>;
+			opp-hz = /bits/ 64 <900000000>;
+			opp-microvolt = <850000>;
+		};
+
+		/*
+		 * Bin 8 is not the vendor's. It is what the driver selects when
+		 * it cannot identify the part at all, so it has to be safe for
+		 * any of them: the S ceiling of 500 MHz, at the highest voltage
+		 * any variant asks for down here. Failing open to the plain
+		 * RK3576 table instead would offer 900 MHz to an S.
+		 */
+		opp-300000000-8 {
+			opp-supported-hw = <0x100 0xffff>;
+			opp-hz = /bits/ 64 <300000000>;
+			opp-microvolt = <750000>;
+		};
+		opp-400000000-8 {
+			opp-supported-hw = <0x100 0xffff>;
+			opp-hz = /bits/ 64 <400000000>;
+			opp-microvolt = <750000>;
+		};
+		opp-500000000-8 {
+			opp-supported-hw = <0x100 0xffff>;
+			opp-hz = /bits/ 64 <500000000>;
+			opp-microvolt = <750000>;
+		};
+
+		/* RK3576S: the NPU stops at 500 MHz, at its own voltage */
+		opp-500000000-3 {
+			opp-supported-hw = <0x08 0xffff>;
+			opp-hz = /bits/ 64 <500000000>;
+			opp-microvolt = <750000>;
+		};
+
+		/*
+		 * RK3576J and RK3576M. The vendor also lists 850 MHz for these,
+		 * left out because BL31's rate table has no 850 entry to ask for.
+		 */
+		opp-300000000-1 {
+			opp-supported-hw = <0x06 0xffff>;
+			opp-hz = /bits/ 64 <300000000>;
+			opp-microvolt = <750000>;
+		};
+		opp-400000000-1 {
+			opp-supported-hw = <0x06 0xffff>;
+			opp-hz = /bits/ 64 <400000000>;
+			opp-microvolt = <750000>;
+		};
+		opp-500000000-1 {
+			opp-supported-hw = <0x06 0xffff>;
+			opp-hz = /bits/ 64 <500000000>;
+			opp-microvolt = <750000>;
+		};
+		opp-600000000-1 {
+			opp-supported-hw = <0x06 0xffff>;
+			opp-hz = /bits/ 64 <600000000>;
+			opp-microvolt = <750000>;
+		};
+		opp-700000000-1 {
+			opp-supported-hw = <0x06 0xffff>;
+			opp-hz = /bits/ 64 <700000000>;
+			opp-microvolt = <787500>;
+		};
+		opp-800000000-1 {
+			opp-supported-hw = <0x06 0xffff>;
+			opp-hz = /bits/ 64 <800000000>;
+			opp-microvolt = <812500>;
+		};
+	};
+};
+
+/* Nothing else votes for this rail, so keep it on; devfreq scales it. */
+&vdd_npu_s0 {
+	regulator-always-on;
+};
