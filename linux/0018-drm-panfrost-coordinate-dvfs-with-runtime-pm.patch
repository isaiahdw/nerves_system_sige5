-		pfdev->pfdevfreq.current_frequency = *freq;
+		pfdevfreq->current_frequency = *freq;
+	mutex_unlock(&pfdevfreq->transition_lock);
+
+	return err;
+}
+
+/*
+ * Leave the firmware-owned clock somewhere safe before the domain goes down.
+ * Caller must still have the domain up. Not an OPP: the parking rate is below
+ * the lowest one the table offers.
+ */
+int panfrost_devfreq_park(struct panfrost_device *pfdev)
+{
+	struct panfrost_devfreq *pfdevfreq = &pfdev->pfdevfreq;
+	unsigned long rate = pfdev->comp->park_rate;
+	int err;
+
+	if (!pfdevfreq->devfreq || !rate)
+		return 0;
+
+	/*
+	 * Through the OPP core rather than clk_set_rate(), even though the
+	 * parking rate is below the lowest OPP. The core rounds to the
+	 * ceiling OPP for voltage and other resources but programs the clock
+	 * to exactly this rate, and records it in current_rate_single_clk.
+	 * A raw clk_set_rate() would leave that bookkeeping at the old OPP,
+	 * and the restore afterwards would then match it and be skipped
+	 * entirely - the clock would never come back up.
+	 */
+	err = dev_pm_opp_set_rate(&pfdev->pdev->dev, rate);
+	if (err)
+		dev_err(&pfdev->pdev->dev, "failed to park at %lu Hz: %d\n",
+			rate, err);
+	else
+		pfdevfreq->current_frequency = rate;
+
+	return err;
+}
+
+/* Put back whatever devfreq last asked for, once the domain is up again. */
+int panfrost_devfreq_restore(struct panfrost_device *pfdev)
+{
+	struct panfrost_devfreq *pfdevfreq = &pfdev->pfdevfreq;
+	unsigned long freq = pfdevfreq->requested_frequency;
+	int err;
+
+	if (!pfdevfreq->devfreq || !freq || freq == pfdevfreq->current_frequency)
+		return 0;
+
+	err = dev_pm_opp_set_rate(&pfdev->pdev->dev, freq);
+	if (err)
+		dev_err(&pfdev->pdev->dev, "failed to restore %lu Hz: %d\n",
+			freq, err);
+	else
+		pfdevfreq->current_frequency = freq;
 
 	return err;
 }
 
+void panfrost_devfreq_transition_lock(struct panfrost_device *pfdev)
+{
+	mutex_lock(&pfdev->pfdevfreq.transition_lock);
+}
+
+void panfrost_devfreq_transition_unlock(struct panfrost_device *pfdev)
+{
+	mutex_unlock(&pfdev->pfdevfreq.transition_lock);
+}
+
+/* Caller holds transition_lock. */
+void panfrost_devfreq_set_available(struct panfrost_device *pfdev, bool avail)
+{
+	pfdev->pfdevfreq.hw_available = avail;
+}
