+	/*
+	 * A rate change reaches the hardware through firmware, which programs
+	 * registers inside the GPU power domain. Reaching them with the domain
+	 * down aborts, so a request that arrives while the hardware is away is
+	 * recorded and reported as retryable rather than being applied. The
+	 * userspace governor's set_freq lands here straight from sysfs, so the
+	 * check cannot live in a governor.
+	 */
+	mutex_lock(&pfdevfreq->transition_lock);
+	pfdevfreq->requested_frequency = *freq;
+	if (!pfdevfreq->hw_available) {
+		/*
+		 * Accepted for deferred application: resume programs it once
+		 * the domain is back. Reporting an error instead would leave
+		 * devfreq retrying every poll forever, since it only advances
+		 * its own bookkeeping on success. current_frequency is left
+		 * alone - it records what the hardware is actually running.
+		 */
+		mutex_unlock(&pfdevfreq->transition_lock);
+		return 0;
+	}
+
 	err = dev_pm_opp_set_rate(dev, *freq);
