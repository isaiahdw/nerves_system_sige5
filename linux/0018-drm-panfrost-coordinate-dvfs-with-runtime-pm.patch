+/*
+ * Returning an error from a runtime resume makes genpd drop the domain, and
+ * the firmware's PVTPLL state must not outlive it - that is the SError this
+ * park exists to prevent. Park while the domain is still up.
+ *
+ * If the park itself fails there is no safe way to release the domain, so hold
+ * it: report the device resumed with DVFS unavailable rather than hand genpd a
+ * domain it is about to power down under a firmware-owned clock. Returns true
+ * when the caller must not proceed to power down.
+ */
+static bool panfrost_park_or_hold(struct panfrost_device *pfdev)
+{
+	bool held = false;
+
+	panfrost_devfreq_transition_lock(pfdev);
+	if (panfrost_devfreq_park(pfdev)) {
+		dev_err(pfdev->dev,
+			"could not park the clock; holding the power domain up\n");
+		held = true;
+	}
+	panfrost_devfreq_set_available(pfdev, false);
+	panfrost_devfreq_transition_unlock(pfdev);
+
+	return held;
+}
+
 static int panfrost_device_runtime_resume(struct device *dev)
 {
 	struct panfrost_device *pfdev = dev_get_drvdata(dev);
@@ -456,11 +482,51 @@ static int panfrost_device_runtime_resume(struct device *dev)
 		}
 	}
 
-	panfrost_device_reset(pfdev);
-	panfrost_devfreq_resume(pfdev);
+	/*
+	 * The domain and helper clocks are back. Put the rate right before any
+	 * register access, then declare the hardware reachable and let the
+	 * governor run again.
+	 */
+	/*
+	 * One locked region: a request arriving between the restore and the
+	 * device becoming available would otherwise be recorded as deferred
+	 * and then never replayed.
+	 */
+	panfrost_devfreq_transition_lock(pfdev);
+	ret = panfrost_devfreq_restore(pfdev);
+	if (!ret) {
+		panfrost_device_reset(pfdev);
+		panfrost_devfreq_set_available(pfdev, true);
+	}
+	panfrost_devfreq_transition_unlock(pfdev);
+	if (ret) {
+		/*
+		 * A failed restore leaves the rate unknown rather than known
+		 * good, so this path needs the park as much as the one below.
+		 */
+		if (panfrost_park_or_hold(pfdev))
+			return 0;
+		goto err_restore;
+	}
+
+	ret = panfrost_devfreq_resume(pfdev);
+	if (ret) {
+		if (panfrost_park_or_hold(pfdev))
+			return 0;
+		goto err_restore;
+	}
 
 	return 0;
 
+err_restore:
+	if (pfdev->comp->pm_features & BIT(GPU_PM_RT)) {
