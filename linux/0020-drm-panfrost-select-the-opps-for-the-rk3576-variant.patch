-static int panfrost_read_speedbin(struct device *dev)
+/*
+ * Bin numbers as the vendor's rockchip_get_soc_info() assigns them. BIT(bin)
+ * is matched against the first cell of opp-supported-hw in the device tree,
+ * so these have to stay in step with the masks there. RK3576_BIN_UNKNOWN is
+ * not one of the vendor's: it selects the restricted table used when the part
+ * cannot be identified.
+ */
+#define RK3576_BIN_BASE		0
+#define RK3576_BIN_M		1
+#define RK3576_BIN_J		2
+#define RK3576_BIN_S		3
+#define RK3576_BIN_UNKNOWN	8
+
+/*
+ * The GPU reaches 900 MHz on the RK3576 and 800 MHz on the S, J and M parts,
+ * which also want their own voltages. The speed-bin cell points at OTP's
+ * specification_serial_number, which holds a part number rather than a ready
+ * made opp-supported-hw value, so it is translated here instead of being
+ * passed through. The second version cell is the speed grade, left open
+ * because the device tree carries the slowest silicon's voltage at each point.
+ *
+ * customer_demand, which the vendor also folds in as bin 4, is not read: for
+ * this GPU bin 4 selects the same OPPs as bin 0.
+ *
+ * This must run even when the read fails: the OPP core disables every OPP
+ * carrying opp-supported-hw unless supported_hw has been set.
+ */
+int panfrost_rk3576_speedbin(struct device *dev)
 {
+	u32 versions[2];
+	int bin;
+	u8 spec;
+	int ret;
+
+	ret = nvmem_cell_read_u8(dev, "speed-bin", &spec);
+	if (ret == -EPROBE_DEFER)
+		return ret;
+	if (ret) {
+		/*
+		 * Fail closed. Assuming the plain RK3576 would hand 900 MHz
+		 * and its lower voltages to a part rated for neither.
+		 */
+		DRM_DEV_INFO(dev, "no speed-bin cell (%d), restricting the OPP table\n",
+			     ret);
+		bin = RK3576_BIN_UNKNOWN;
+	} else {
+		switch (spec) {
+		case 0x0d:
+			bin = RK3576_BIN_M;
+			break;
+		case 0x0a:
+			bin = RK3576_BIN_J;
+			break;
+		case 0x13:
+			bin = RK3576_BIN_S;
+			break;
+		default:
+			bin = RK3576_BIN_BASE;
+			break;
+		}
+		DRM_DEV_INFO(dev, "gpu bin %d (otp 0x%02x)\n", bin, spec);
+	}
+
+	versions[0] = BIT(bin);
+	versions[1] = 0xffff;
+
+	return devm_pm_opp_set_supported_hw(dev, versions, ARRAY_SIZE(versions));
+}
+
+static int panfrost_read_speedbin(struct panfrost_device *pfdev)
+{
+	struct device *dev = &pfdev->pdev->dev;
 	u32 val;
 	int ret;
 
+	if (pfdev->comp->read_speedbin)
+		return pfdev->comp->read_speedbin(dev);
+
 	ret = nvmem_cell_read_variable_le_u32(dev, "speed-bin", &val);
 	if (ret) {
 		/*
@@ -228,7 +301,7 @@
 		return 0;
 	}
 
-	ret = panfrost_read_speedbin(dev);
+	ret = panfrost_read_speedbin(pfdev);
 	if (ret)
 		return ret;
 
