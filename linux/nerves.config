# Nerves additions on top of the arm64 defconfig (kernel 6.18.y).
#
# The arm64 defconfig already has =y: MMC_DW_ROCKCHIP, SQUASHFS,
# SERIAL_8250_DW, I2C_RK3X, MFD_RK8XX_I2C, REGULATOR_RK808 (covers the
# RK806), DW_WATCHDOG, MTD_SPI_NOR, PCIE_ROCKCHIP_DW_HOST,
# SCSI_UFS_ROCKCHIP, PHY_ROCKCHIP_INNO_USB2, USB_DWC3, ROCKCHIP_IOMMU,
# REALTEK_PHY, ARM_SCMI_PROTOCOL, and the Rockchip clk/pinctrl/gpio core.

# Ethernet built in (the defconfig has stmmac as a module; the dwmac-rk
# glue follows it)
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y

# Display built in for the HDMI framebuffer console: DRM core is =m in
# the defconfig and gates everything else. VOP2 and the dw-hdmi-qp
# bridge are sub-options of DRM_ROCKCHIP.
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_HDMI_QP=y
CONFIG_PHY_ROCKCHIP_SAMSUNG_HDPTX=y

# GPU: open Panfrost driver (Mali G52). The Mesa userspace is not in the
# image yet (Buildroot 2026.05 makes the panfrost driver depend on LLVM);
# the kernel side is ready for it.
CONFIG_DRM_PANFROST=m

# USB3/DP and PCIe/USB3 combo phys
CONFIG_PHY_ROCKCHIP_USBDP=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y

# Boot SPI NOR (holds U-Boot); flashcp-able as an unpartitioned mtd
CONFIG_SPI_ROCKCHIP_SFC=y

# HYM8563 RTC sets the clock at boot, so build it in
CONFIG_RTC_DRV_HYM8563=y

# SARADC + thermal
CONFIG_ROCKCHIP_SARADC=y
CONFIG_ROCKCHIP_THERMAL=y

# HDMI audio (simple-audio-card + Rockchip SAI); modules are fine since
# audio starts after the rootfs is up
CONFIG_SND_SOC_ROCKCHIP=m
CONFIG_SND_SOC_ROCKCHIP_SAI=m

# The application data partition is f2fs
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_SECURITY=y

# TUN/TAP built in: standard Nerves expectation (VPNs, overlay networks)
CONFIG_TUN=y

# vintage_net's RouteManager uses policy routing. IP_ADVANCED_ROUTER is
# required for IP_MULTIPLE_TABLES to take effect (kconfig dependency —
# without it the symbol is silently dropped and route updates fail with
# "Address family not supported by protocol").
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y

# Watchdog must not be disarmable once Erlang heart opens it
CONFIG_WATCHDOG_NOWAYOUT=y

# Reboot 10s after a kernel panic (alongside the heart-armed watchdog)
CONFIG_PANIC_TIMEOUT=10

# Nerves devices must never sleep
# CONFIG_SUSPEND is not set

# squashfs rootfs read performance
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y

# Generic Nerves niceties (cf. official systems)
CONFIG_POSIX_MQUEUE=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_OF_OVERLAY=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_PATTERN=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# Plug-and-play USB peripherals as modules (zero cost until plugged in)
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_EXFAT_FS=m

# FAT short-name codepage for western-European USB sticks
CONFIG_NLS_CODEPAGE_850=y
# erlinit mounts the FAT boot partition with iocharset=ascii (the arm64
# defconfig doesn't include this NLS; without it the mount fails with
# "IO charset ascii not found")
CONFIG_NLS_ASCII=y

# Onboard WiFi (board v1.2+): BCM43752/SYN43752 on the sdio host, driven
# by brcmfmac (cfg80211 stays =m from the defconfig, so regulatory.db
# loads after the rootfs is up)
CONFIG_BRCMFMAC=m

# No CMA_SIZE_MBYTES override: the 16 MB default is enough here, and is
# what the vendor BSP runs with too. The two big contiguous consumers on
# this SoC are both behind IOMMUs - "27d00000.vop: Adding to iommu group
# 0" and "27700000.npu: Adding to iommu group 1" - so their buffers are
# pageable. What remains is a few MB of driver coherent allocations.
