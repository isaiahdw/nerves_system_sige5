BR2_aarch64=y
BR2_cortex_a72=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/nerves-project/toolchains/releases/download/v15.3.0/nerves_toolchain_aarch64_nerves_linux_gnu-linux_${shell uname -m}-15.3.0-8DAF9F3.tar.xz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="aarch64-nerves-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_0=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_FORTRAN=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
BR2_TAR_OPTIONS="--no-same-owner"
BR2_BACKUP_SITE="https://dl.nerves-project.org"
BR2_GLOBAL_PATCH_DIR="${BR2_EXTERNAL_NERVES_PATH}/patches"
BR2_REPRODUCIBLE=y
BR2_ROOTFS_SKELETON_CUSTOM=y
BR2_ROOTFS_SKELETON_CUSTOM_PATH="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/skeleton"
BR2_INIT_NONE=y
BR2_ROOTFS_DEVICE_TABLE="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/device_table.txt"
BR2_ENABLE_LOCALE_WHITELIST="locale-archive"
BR2_GENERATE_LOCALE="en_US.UTF-8"
BR2_ROOTFS_OVERLAY="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/rootfs_overlay ${NERVES_DEFCONFIG_DIR}/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="${NERVES_DEFCONFIG_DIR}/post-build.sh ${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="${NERVES_DEFCONFIG_DIR}/post-createfs.sh"
BR2_LINUX_KERNEL=y
# Mainline LTS. The Sige5 device tree is upstream; the only board patch
# is linux/0001 (mmc aliases so the eMMC is mmcblk0, watchdog enable).
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.40"
BR2_LINUX_KERNEL_PATCH="${NERVES_DEFCONFIG_DIR}/linux"
# arm64 defconfig plus the Nerves fragment (built-in storage/net/display
# and Nerves requirements, documented inline).
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/linux/nerves.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# The .dtb basename must match the devicetree.dtb resource in fwup.conf.
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3576-armsom-sige5"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_BUSYBOX_CONFIG="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/busybox.config"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/busybox.fragment"
BR2_PACKAGE_F2FS_TOOLS=y
# resizepart, used by /usr/sbin/expand-app-fs to grow the app partition
# on the first boot after a maskrom/image flash.
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_DTC=y
BR2_PACKAGE_LIBMNL=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_WIRED=y
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
BR2_PACKAGE_WPA_SUPPLICANT_AUTOSCAN=y
BR2_PACKAGE_WPA_SUPPLICANT_HOTSPOT=y
BR2_PACKAGE_WPA_SUPPLICANT_DEBUG_SYSLOG=y
BR2_PACKAGE_WPA_SUPPLICANT_WPS=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_KMOD_XZ=y
# uboot-env.bin is generated from uboot/uboot.env; u-boot-rockchip.bin is
# written to the eMMC by the fwup factory image (see uboot/README.md).
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE_SOURCE="${NERVES_DEFCONFIG_DIR}/uboot/uboot.env"
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE_SIZE="131072"
BR2_NERVES_SYSTEM_NAME="nerves_system_sige5"
BR2_NERVES_ADDITIONAL_IMAGE_FILES="${NERVES_DEFCONFIG_DIR}/fwup.conf ${NERVES_DEFCONFIG_DIR}/extlinux-a.conf ${NERVES_DEFCONFIG_DIR}/extlinux-b.conf ${NERVES_DEFCONFIG_DIR}/uboot/u-boot-rockchip.bin"
BR2_PACKAGE_NBTTY=y
# Onboard WiFi (board v1.2+): Synaptics SYN43752 (BCM43752/AP6275S) on
# SDIO, driven by the in-kernel brcmfmac. The firmware, CLM blob and
# NVRAM are not in upstream linux-firmware; package/brcmfmac43752-firmware
# installs them from the Armbian firmware collection. v1.0/1.1 boards
# have an RTL8852BS with no mainline driver. Bluetooth (uart4 serdev)
# is not brought up.
BR2_PACKAGE_BRCMFMAC43752_FIRMWARE=y
# NPU: vendor rknpu kernel driver ported to mainline (out-of-tree module,
# CMA buffers, fixed 600 MHz clock - see package/rknpu-driver and
# linux/0002) plus the matching librknnrt 2.3.2 runtime.
BR2_PACKAGE_RKNPU_DRIVER=y
BR2_PACKAGE_LIBRKNNRT=y
BR2_PACKAGE_NERVES_CONFIG=y
BR2_PACKAGE_NERVES_CONFIG_ACCEPT_RNG_NOTICE=y
# GPU userspace: Mesa panfrost (EGL/GLES2 over GBM/KMS; no X11 or
# Wayland ships in the system). Buildroot requires LLVM in the target
# Mesa for panfrost - the real requirement is the host-side shader
# precompiler (mesa_clc/panfrost_compile); the target-LLVM link is
# packaging conservatism that costs rootfs size, acceptable on this
# class of board. kmscube is included as a GL smoke test.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_KMSCUBE=y
# glmark2 measures GPU frequency scaling: its drm-glesv2 flavor renders
# off-screen through GBM, so a scene can be made fragment-bound and its
# frame rate read without a display in the loop. stress-ng's --gpu class
# runs many contexts at once, which exercises the runtime-PM/DVFS seam
# that a single-context benchmark does not.
BR2_PACKAGE_GLMARK2=y
BR2_PACKAGE_STRESS_NG=y
# Input: eudev (dynamic /dev) and libinput, the input layer DRM/KMS UI
# stacks read USB keyboards/mice/touchscreens through. No UI toolkit ships
# in the system — bring your own (a Flutter embedder, LVGL, Slint, Qt, ...)
# from the application side.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_LIBINPUT=y
# Audio: HDMI audio and the onboard analog ES8388 codec, both in the
# mainline dts. ALSA userspace: aplay/amixer/alsactl + speaker-test.
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
