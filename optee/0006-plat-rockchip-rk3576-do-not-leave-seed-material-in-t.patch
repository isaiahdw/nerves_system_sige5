From c7597e0b74d17048b5709862ede77c37733f3fcc Mon Sep 17 00:00:00 2001
From: Isaiah <isaiahdw@gmail.com>
Date: Tue, 4 Aug 2026 21:33:45 -0700
Subject: [PATCH 06/12] plat-rockchip: rk3576: do not leave seed material in
 the TRNG registers

RKRNG holds the last generated block in its data registers until something
requests another, and this is the non-secure instance, so the normal world can
read it. Reading DATA0 from the U-Boot prompt after a boot returned 32 bytes of
the seed OP-TEE had just used.

Request once more before returning, so what is left behind is a block no caller
was given.
---
 core/arch/arm/plat-rockchip/platform_config.h | 10 ++++++----
 core/arch/arm/plat-rockchip/platform_rk3576.c | 15 +++++++++++++++
 2 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/core/arch/arm/plat-rockchip/platform_config.h b/core/arch/arm/plat-rockchip/platform_config.h
index 101a968..d965a99 100644
--- a/core/arch/arm/plat-rockchip/platform_config.h
+++ b/core/arch/arm/plat-rockchip/platform_config.h
@@ -223,10 +223,12 @@
  * gracefully. This one is in the vendor and mainline device trees as
  * rng@2a410000, so it is the address that can be confirmed.
  *
- * Only read while seeding, during OP-TEE core init, which is before any
- * normal-world software beyond TF-A and U-Boot SPL is running. That bounds
- * the exposure of sharing the block, and has to be revisited before a key
- * derived from it is fused into OTP.
+ * Sharing the block with the normal world costs three things. Its data
+ * registers hold the last generated block until something requests another,
+ * so hw_get_random_bytes() overwrites them before returning. Linux owns the
+ * block's reset and gate, so it cannot be relied on once the kernel is up.
+ * And the mode selector is normal-world writable, which a warm reboot could
+ * carry into the next boot's seeding.
  */
 #define TRNG_NS_BASE		0x2a410000
 #define TRNG_NS_SIZE		SIZE_K(4)
diff --git a/core/arch/arm/plat-rockchip/platform_rk3576.c b/core/arch/arm/plat-rockchip/platform_rk3576.c
index e6c1842..8065b2e 100644
--- a/core/arch/arm/plat-rockchip/platform_rk3576.c
+++ b/core/arch/arm/plat-rockchip/platform_rk3576.c
@@ -126,6 +126,21 @@ TEE_Result hw_get_random_bytes(void *buf, size_t blen)
 		remaining -= copy_len;
 	}
 
+	/*
+	 * The data registers keep the last block until something asks for
+	 * another, and the normal world can read them. Leave a block behind
+	 * that no caller has been given.
+	 */
+	io_write32(base + RKRNG_CTRL,
+		   SHIFT_U32(RKRNG_CTRL_REQ_TRNG, 16) | RKRNG_CTRL_REQ_TRNG);
+	if (IO_READ32_POLL_TIMEOUT(base + RKRNG_STATE, val,
+				   val & RKRNG_STATE_TRNG_RDY,
+				   RKRNG_POLL_PERIOD_US,
+				   RKRNG_POLL_TIMEOUT_US))
+		EMSG("RKRNG did not overwrite its output registers");
+	else
+		io_write32(base + RKRNG_STATE, RKRNG_STATE_TRNG_RDY);
+
 out:
 	memzero_explicit(block, sizeof(block));
 	memzero_explicit(&val, sizeof(val));
