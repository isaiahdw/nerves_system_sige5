Select the NPU OPPs for the chip's variant

The device tree now carries the vendor's per-bin OPPs - RK3576 alongside
the S, J and M parts, which have their own frequencies and voltages, the
S stopping at 500 MHz. Nothing selects between them yet, and the OPP core
treats that as a hard error rather than a default: an OPP carrying
opp-supported-hw is disabled outright unless the driver has set
supported_hw, so without this the whole table would come up empty.

Read specification_serial_number from OTP and map it the way the vendor's
rockchip_get_soc_info() does - 0xd is M, 0xa is J, 0x13 is S, anything
else is a plain RK3576 - then set BIT(bin) as the first word. This board
reads 0x01 and lands on bin 0, which is the standard table it was already
getting.

The second word is left as 0xffff to accept any speed grade. That is the
axis the vendor drives from a PVTM measurement rather than a fuse, and
reimplementing it means sampling a ring oscillator through npu_grf inside
the NPU domain - the same class of access that has hung this SoC before,
for a power saving. The device tree stands in for it by listing the
voltage the slowest silicon in each bin needs.

-EPROBE_DEFER is propagated so probe comes back once the OTP driver has
bound. Any other read failure selects RKNPU_BIN_UNKNOWN rather than
guessing: bin 0 would offer 900 MHz to an RK3576S whose NPU stops at 500,
so the device tree carries a restricted table under that mask instead.

Signed-off-by: Isaiah DeRose-Wilson <isaiahdw@gmail.com>

--- a/rknpu_devfreq.c
+++ b/rknpu_devfreq.c
@@ -16,6 +16,7 @@
 #include <linux/clk.h>
 #include <linux/devfreq.h>
 #include <linux/devfreq_cooling.h>
+#include <linux/nvmem-consumer.h>
 #include <linux/pm_opp.h>
 #include <linux/pm_runtime.h>
 #include <linux/regulator/consumer.h>
@@ -260,6 +261,71 @@
 {
 }
 
+/*
+ * Bin numbers as the vendor's rockchip_get_soc_info() assigns them, and one of
+ * ours. BIT(bin) is matched against the first cell of opp-supported-hw in the
+ * device tree, so these have to stay in step with the masks there.
+ */
+#define RKNPU_BIN_RK3576	0
+#define RKNPU_BIN_RK3576M	1
+#define RKNPU_BIN_RK3576J	2
+#define RKNPU_BIN_RK3576S	3
+/* Not the vendor's: the restricted table used when the part is unknown. */
+#define RKNPU_BIN_UNKNOWN	8
+
+/*
+ * Pick the OPPs for this chip's variant. specification_serial_number in OTP
+ * separates RK3576 from the S, J and M parts, which have their own frequencies
+ * and voltages - the S stops at 500 MHz. The second word is left open: that is
+ * the speed grade, which the device tree stands in for by carrying the slowest
+ * silicon's voltage for each point.
+ *
+ * This must run even when the read fails: the OPP core disables any OPP
+ * carrying opp-supported-hw unless supported_hw has been set.
+ */
+static int npu_devfreq_set_supported_hw(struct device *dev)
+{
+	u32 versions[2];
+	int bin = RKNPU_BIN_RK3576;
+	u8 spec;
+	int ret;
+
+	ret = nvmem_cell_read_u8(dev, "specification_serial_number", &spec);
+	if (ret == -EPROBE_DEFER)
+		return ret;
+	if (ret) {
+		/*
+		 * Fail closed. Guessing the plain RK3576 table would hand
+		 * 900 MHz to an RK3576S whose NPU stops at 500.
+		 */
+		LOG_DEV_WARN(dev,
+			     "no specification_serial_number (%d), restricting the OPP table\n",
+			     ret);
+		bin = RKNPU_BIN_UNKNOWN;
+	} else {
+		switch (spec) {
+		case 0x0d:
+			bin = RKNPU_BIN_RK3576M;
+			break;
+		case 0x0a:
+			bin = RKNPU_BIN_RK3576J;
+			break;
+		case 0x13:
+			bin = RKNPU_BIN_RK3576S;
+			break;
+		default:
+			bin = RKNPU_BIN_RK3576;
+			break;
+		}
+		LOG_DEV_INFO(dev, "npu bin %d (otp 0x%02x)\n", bin, spec);
+	}
+
+	versions[0] = BIT(bin);
+	versions[1] = 0xffff;
+
+	return devm_pm_opp_set_supported_hw(dev, versions, ARRAY_SIZE(versions));
+}
+
 int rknpu_devfreq_init(struct rknpu_device *rknpu_dev)
 {
 	struct device *dev = rknpu_dev->dev;
@@ -292,6 +358,12 @@
 		}
 	}
 
+	ret = npu_devfreq_set_supported_hw(dev);
+	if (ret) {
+		LOG_DEV_ERROR(dev, "failed to set supported hw: %d\n", ret);
+		return ret;
+	}
+
 	ret = devm_pm_opp_of_add_table(dev);
 	if (ret) {
 		LOG_DEV_ERROR(dev, "failed to add opp table: %d\n", ret);
