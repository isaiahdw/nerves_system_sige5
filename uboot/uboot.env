# Nerves U-Boot environment for the ArmSoM Sige5 / BPI-M5 Pro (RK3576)
#
# Compiled into uboot-env.bin and written raw at 15 MB (0xF00000) on the eMMC
# — see fwup_include/fwup-common.conf and rootfs_overlay/etc/fw_env.config.
#
# U-Boot (mainline, CONFIG_ENV_IS_IN_MMC with ENV_OFFSET=0xF00000
# and SYS_MMC_ENV_DEV=0 = the eMMC; see scripts/build-uboot.sh) loads this
# environment and runs `bootcmd` below, which implements A/B slot selection
# with automatic revert of unvalidated firmware.
#
# NOTE: loading a saved environment REPLACES U-Boot's built-in defaults, so
# the memory-layout variables from include/configs/rk3576_common.h (v2026.01)
# are reproduced here, and boot_targets is kept so the `bootflow scan`
# fallback at the end of bootcmd still works.

# A/B boot with automatic revert, then fall back to standard boot (extlinux/
# extlinux.conf on the FAT partition) if the nerves boot path fails. If the
# saved env is ever corrupted, U-Boot ignores it entirely and its compiled-in
# default bootcmd (bootflow scan) boots the extlinux config instead —
# automatic recovery either way.
bootcmd=run nerves_init nerves_boot; bootflow scan -lb

# From rk3576_common.h ENV_MEM_LAYOUT_SETTINGS (U-Boot v2026.01)
scriptaddr=0x40c00000
script_offset_f=0xffe000
script_size_f=0x2000
pxefile_addr_r=0x40e00000
kernel_addr_r=0x42000000
kernel_comp_addr_r=0x4a000000
kernel_comp_size=0x8000000
fdt_addr_r=0x52000000
fdtoverlay_addr_r=0x52100000
ramdisk_addr_r=0x52180000

# For the bootflow scan fallback: eMMC first, then the microSD (both
# are in this board's boot ROM path).
boot_targets=mmc0 mmc1

#
# Nerves variables
#

nerves_fw_active=a

# Validation is performed by nerves_runtime's startup guard once all OTP
# applications start (autovalidate=0). If a newly-installed firmware fails
# to reach that point before the next boot, nerves_init reverts to the
# previous slot.
nerves_fw_autovalidate=0

# Set to 1 at factory-flash time (fwup complete) since that firmware is
# implicitly trusted.
nerves_fw_validated=1

# 0 on the first boot after an install; U-Boot sets it to 1 so a second
# boot without validation triggers the revert.
nerves_fw_booted=0

nerves_revert=\
    if test ${nerves_fw_active} = "a"; then\
        echo "Reverting to firmware slot B";\
        setenv nerves_fw_active "b";\
    else\
        echo "Reverting to firmware slot A";\
        setenv nerves_fw_active "a";\
    fi

nerves_init=\
    if test ${nerves_fw_booted} = 1; then\
        if test ${nerves_fw_validated} = 0; then\
            run nerves_revert;\
            setenv nerves_fw_validated 1;\
            saveenv;\
        fi;\
    else\
        setenv nerves_fw_booted 1;\
        if test ${nerves_fw_autovalidate} = 1; then\
            setenv nerves_fw_validated 1;\
        fi;\
        saveenv;\
    fi;\
    setenv bootfile Image.${nerves_fw_active};\
    setenv fdtfile rk3576-armsom-sige5.${nerves_fw_active}.dtb;\
    if test ${nerves_fw_active} = "a"; then\
        setenv uenv_root PARTUUID=e7461250-672a-42ec-a738-0f38cf1e933d;\
    else\
        setenv uenv_root PARTUUID=187d8d14-28ac-429c-84cd-dc585a1b9b97;\
    fi

console=ttyS0,1500000
cmdline=

nerves_setargs=setenv bootargs console=${console} console=tty1 root=${uenv_root} rootfstype=squashfs rootwait ${cmdline}

nerves_boot=\
    load mmc 0:1 ${kernel_addr_r} ${bootfile};\
    load mmc 0:1 ${fdt_addr_r} ${fdtfile};\
    run nerves_setargs;\
    booti ${kernel_addr_r} - ${fdt_addr_r}
